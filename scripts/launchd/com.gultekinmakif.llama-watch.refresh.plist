<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.gultekinmakif.llama-watch.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /ABSOLUTE/PATH/TO/llama-watch && ./scripts/refresh.sh</string>
  </array>
  <key>StartInterval</key>    <integer>3600</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>/ABSOLUTE/PATH/TO/llama-watch/var/log/refresh.out</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/llama-watch/var/log/refresh.err</string>
</dict>
</plist>
